# Copy this file to .env. Never commit real secrets.
APP_ENV=production
JENNY_SECRET_KEY=replace-with-a-long-random-secret
JENNY_WHATSAPP_NUMBER=2348000000000
DATABASE_URL=sqlite:///jennys.db
COOKIE_SECURE=0 # set to 1 when served over HTTPS
# Paystack: use test keys first
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
# Optional email campaigns and order notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ORDER_NOTIFICATION_EMAIL=
